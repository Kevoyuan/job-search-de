    {
      "dot": "cyan",
      "title": "Privacy-First Architecture",
      "items": [
        "Candidate profile strictly decoupled from pipeline logic",
        "Personal facts & preferences reside solely in local .job-search/",
        "Zero cloud upload guarantees candidate confidentiality"
      ]
    },
    {
      "dot": "emerald",
      "title": "Live & Verified ATS Discovery",
      "items": [
        "Direct queries to official ATS APIs bypass aggregator noise",
        "Real-time HTTP health checks & Schema.org JSON-LD dates",
        "Filters expired listings, ghost reposts, and recruiter spam"
      ]
    },
    {
      "dot": "violet",
      "title": "Two-Stage Evidence Scoring",
      "items": [
        "Stage 1 fast triage for hard constraints & seniority",
        "Stage 2 deep matching requires citing verifiable profile facts",
        "Eliminates LLM score inflation and hallucinated matches"
      ]
    },
    {
      "dot": "amber",
      "title": "Multi-Theme Interactive Delivery",
      "items": [
        "4 distinct zero-token CSS themes (Notion, Obsidian, Bauhaus, Bento)",
        "Direct local editing via native File System Access API",
        "Kanban & table views with one-click tailored pitch generation"
      ]
